spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/core_db
    username: core
    password: core

  jpa:
    show-sql: true
    hibernate:
      ddl-auto: validate

  rabbitmq:
    host: localhost
    port: 5672
    username: umt
    password: umt

tmdb:
  api-key:         # get at https://www.themoviedb.org/settings/api

igdb:
  client-id:       # register an app at https://dev.twitch.tv/console/apps, use its Client ID
  client-secret:   # generate a new secret for that same app